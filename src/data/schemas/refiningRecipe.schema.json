{
  "$id": "refiningRecipe.schema.json",
  "title": "RefiningRecipe",
  "type": "object",
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "resourceId": { "type": "string", "minLength": 1 },
          "quantity": { "type": "integer", "minimum": 1 }
        },
        "required": ["resourceId", "quantity"],
        "additionalProperties": false
      }
    },
    "outputResourceId": { "type": "string", "minLength": 1 },
    "outputQuantity": { "type": "integer", "minimum": 1 }
  },
  "required": ["id", "name", "inputs", "outputResourceId", "outputQuantity"],
  "additionalProperties": false
}
