{
  "$id": "voyage.schema.json",
  "title": "Voyage",
  "type": "object",
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "shipId": { "type": "string", "minLength": 1 },
    "originPlanetId": { "type": "string", "minLength": 1 },
    "destinationPlanetId": { "type": "string", "minLength": 1 },
    "departedAt": { "type": "integer", "minimum": 0 },
    "arrivesAt": { "type": "integer", "minimum": 0 },
    "cargo": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "itemId": { "type": "string", "minLength": 1 },
          "quantity": { "type": "integer", "minimum": 1 }
        },
        "required": ["itemId", "quantity"],
        "additionalProperties": false
      }
    },
    "encounters": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": { "const": "tradeOpportunity" },
              "windowIndex": { "type": "integer", "minimum": 0 },
              "outcome": {
                "type": "object",
                "properties": {
                  "creditsGranted": { "type": "number", "minimum": 0 }
                },
                "required": ["creditsGranted"],
                "additionalProperties": false
              }
            },
            "required": ["type", "windowIndex", "outcome"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": { "const": "discovery" },
              "windowIndex": { "type": "integer", "minimum": 0 },
              "outcome": {
                "type": "object",
                "properties": {
                  "resourceId": { "type": "string", "minLength": 1 },
                  "qualities": { "$ref": "qualityRoll.schema.json" }
                },
                "required": ["resourceId", "qualities"],
                "additionalProperties": false
              }
            },
            "required": ["type", "windowIndex", "outcome"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": { "const": "hazard" },
              "windowIndex": { "type": "integer", "minimum": 0 },
              "outcome": {
                "type": "object",
                "properties": {
                  "passed": { "type": "boolean" },
                  "creditsLost": { "type": "number", "minimum": 0 }
                },
                "required": ["passed", "creditsLost"],
                "additionalProperties": false
              }
            },
            "required": ["type", "windowIndex", "outcome"],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": ["id", "shipId", "originPlanetId", "destinationPlanetId", "departedAt", "arrivesAt", "cargo"],
  "additionalProperties": false
}
