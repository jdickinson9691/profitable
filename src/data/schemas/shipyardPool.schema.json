{
  "$id": "shipyardPool.schema.json",
  "title": "ShipyardPool",
  "type": "object",
  "properties": {
    "planetId": { "type": "string", "minLength": 1 },
    "availableShips": {
      "type": "array",
      "items": { "$ref": "shipCandidate.schema.json" }
    },
    "lastRefreshedAt": { "type": "integer", "minimum": 0 }
  },
  "required": ["planetId", "availableShips", "lastRefreshedAt"],
  "additionalProperties": false
}
