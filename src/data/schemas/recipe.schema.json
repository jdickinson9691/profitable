{
  "$id": "recipe.schema.json",
  "title": "Recipe",
  "type": "object",
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "category": { "type": "string", "minLength": 1 },
          "quantity": { "type": "integer", "minimum": 1 },
          "thresholdQuality": { "$ref": "quality.schema.json" },
          "thresholdValue": { "type": "integer", "minimum": 1, "maximum": 100 }
        },
        "required": ["category", "quantity"],
        "additionalProperties": false,
        "dependencies": {
          "thresholdQuality": ["thresholdValue"],
          "thresholdValue": ["thresholdQuality"]
        }
      }
    },
    "outputResourceId": { "type": "string", "minLength": 1 },
    "outputQuantity": { "type": "integer", "minimum": 1 }
  },
  "required": ["id", "name", "inputs", "outputResourceId", "outputQuantity"],
  "additionalProperties": false
}
