<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProfitableCore\ProfitableCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copies of the real content/*.json files (see Fixtures/README.md),
         copied to the test output directory so ContentLoader tests can
         read them via a real file path, proving the "port, don't
         redesign" claim against actual current content, not synthetic
         toy data. -->
    <None Include="Fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The real parity corpus (see agent-33-unity-parity-validation.md),
         generated by `npm run parity` from ..\parity\ (outside this
         project) rather than duplicated, linked in under Parity\ in the
         output directory so ParityTests.cs can read it via a real file
         path. -->
    <None Include="..\parity\ts-parity-results.json" Link="Parity\ts-parity-results.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
